{
  "name": "amicrespa",
  "version": "1.0.0",
  "private": true,
  "description": "Amicrespa — Fase 1: sitio web premium y panel administrativo",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "clean": "node scripts/limpiar.mjs",
    "rebuild": "npm run clean && npm run build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:check": "tsx prisma/check-db.ts",
    "db:check-media": "tsx prisma/check-media.ts",
    "siigo:mapear": "tsx -r dotenv/config scripts/siigo/aplicar-mapeo.ts dotenv_config_path=.env",
    "siigo:verificar": "tsx -r dotenv/config scripts/siigo/verificar.ts dotenv_config_path=.env",
    "siigo:catalogo": "tsx -r dotenv/config scripts/siigo/catalogo.ts dotenv_config_path=.env",
    "siigo:auditar": "tsx -r dotenv/config scripts/siigo/auditar.ts dotenv_config_path=.env",
    "siigo:probar": "tsx -r dotenv/config scripts/siigo/probar-factura.ts dotenv_config_path=.env",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "setup": "prisma generate && prisma migrate deploy && npm run db:seed",
    "marca": "node scripts/marca.mjs",
    "preflight": "tsx -r dotenv/config scripts/preflight.ts dotenv_config_path=.env",
    "manual:capturas": "node -r dotenv/config scripts/manual-capturas.mjs dotenv_config_path=.env",
    "manual:pdf": "node scripts/manual-pdf.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@supabase/supabase-js": "^2.112.2",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "prisma": "^6.1.0",
    "puppeteer": "^25.11.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
