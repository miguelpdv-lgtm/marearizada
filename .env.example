# =============================================================================
# Base de datos — PostgreSQL en Supabase
# =============================================================================
# Las dos cadenas salen de: Supabase → Project Settings → Database →
# Connection string → pestaña "ORMs" (o "Connection pooling").
#
# DATABASE_URL  Transaction pooler, puerto 6543. La usa la aplicación.
#               Necesita ?pgbouncer=true&connection_limit=5&pool_timeout=20
#               Con connection_limit=1 el `next build` falla: el prerender
#               genera páginas en paralelo y agota el pool (error P2024).
#               En Vercel u otro entorno serverless, baja el límite a 1.
#
# DIRECT_URL    Session pooler, puerto 5432. La usan las migraciones.
#               Usa el pooler (…pooler.supabase.com) y no la conexión directa
#               db.<ref>.supabase.co: esa última es solo IPv6 y suele fallar
#               desde redes domésticas y desde Windows.
#
# Reemplaza <REF>, <PASSWORD> y <REGION> por los de tu proyecto.
# Si la contraseña tiene caracteres especiales, codifícalos para URL
# (@ = %40, # = %23, / = %2F, : = %3A).

DATABASE_URL="postgresql://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# =============================================================================
# Supabase Storage — subida de imágenes y videos desde el panel
# =============================================================================
# La service role key omite RLS. Solo se usa en el servidor, para firmar
# permisos de subida; nunca se envía al navegador.
# Está en: Supabase → Project Settings → API Keys → service_role (Reveal).
NEXT_PUBLIC_SUPABASE_URL="https://<REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# =============================================================================
# Sesión del panel administrativo
# =============================================================================
# Genera una clave nueva con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres"

# =============================================================================
# Primer administrador (solo lo usa el seed, al crear el usuario)
# =============================================================================
SEED_ADMIN_EMAIL="admin@marearizada.com"
SEED_ADMIN_PASSWORD="cambia-esta-contrasena"

# =============================================================================
# Sitio
# =============================================================================
# En local se deja en localhost. En produccion va el dominio real, SIN barra
# final y con el mismo host que se registre en Bold (con o sin www, pero el
# mismo en los dos lados): de aqui salen la URL de retorno del pago, la del
# webhook y el metadataBase de las etiquetas Open Graph.
#   Produccion: https://marearizada.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# =============================================================================
# Bold — pagos en línea de la tienda
# =============================================================================
# Se sacan de: bold.co → Integraciones → Llaves de integración.
# Cada llave tiene una versión de prueba: se puede integrar todo con esas
# antes de mover plata real. Requiere tener "pagos en línea" activo en la
# cuenta — no basta con el datáfono.
#
# BOLD_IDENTITY_KEY   Llave de identidad. Se renderiza en el atributo
#                     data-api-key del botón, así que es pública por diseño.
# BOLD_SECRET_KEY     Llave secreta. Solo servidor: firma de integridad de
#                     cada cobro. Nunca se envía al navegador.
# BOLD_WEBHOOK_SECRET Con qué se valida la firma del webhook. Normalmente es
#                     la misma llave secreta; en el ambiente de prueba Bold
#                     firma con cadena vacía, así que se deja vacía al probar.
#                     EN PRODUCCIÓN NO PUEDE QUEDAR VACÍA: el HMAC de una llave
#                     vacía lo calcula cualquiera, y un webhook falso da por
#                     pagado un abono que nadie pagó. Con NODE_ENV=production
#                     y esta variable vacía, /api/bold/webhook responde 503 y
#                     no procesa nada.
BOLD_IDENTITY_KEY=""
BOLD_SECRET_KEY=""
BOLD_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Resend — correo transaccional (confirmaciones y recordatorios de cita)
# ---------------------------------------------------------------------------
# La llave sale de resend.com → API Keys. Sin ella el sitio funciona igual:
# las citas se guardan, simplemente no sale correo y queda el
# aviso en el log.
RESEND_API_KEY=

# Remitente. El dominio tiene que estar verificado por DNS en Resend
# (Domains → Add domain → registros SPF/DKIM). Mientras no lo esté, Resend
# solo acepta onboarding@resend.dev y solo hacia el correo de la cuenta.
#
# Para que lleguen a "Principal" y no a "Promociones": usa una dirección solo
# para estos avisos (p. ej. citas@marearizada.com) y nunca la misma con la que
# se mandan boletines o campañas; publica un registro DMARC en el DNS además
# de SPF y DKIM.
RESEND_FROM="Marea Rizada <citas@marearizada.com>"

# A dónde llegan los avisos internos (cita nueva, cambios de cita). Vacío = usa el contact.email de la configuración del sitio.
RESEND_SALON=
